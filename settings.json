{
    // 應用層設定（JSON5 格式：可加註解）。
    // db 連線等系統參數仍在 g_getSettings.mjs（供 g_mOrm 共用）；本檔放可調整之 app 設定。
    // srv.mjs 以 `node srv.mjs <pathSettings>` 載入本檔（預設 ./settings.json），供日後更細緻功能擴充。

    // 是否顯示右上語系切換選單：'y' 顯示 / 'n' 隱藏
    showLanguage: 'y',

    // 初始語系（server 注入 index.html → 首次載入即此語系）：'eng' / 'cht'
    language: 'eng',

    // 伺服器通訊 port
    serverPort: 11005,
    
    logFd: './logs',
    logInterval: 'hr',
    logNumKeep: 8760, //log 檔保留數上限, 超出者自最舊刪除; hr 模式每小時 1 檔, 8760 約 1 年 (= w-syslog 預設, 未給亦同)

    // 測試分頁代發請求之目標位址政策: 預設拒絕內網與本機位址 (loopback、私有網段、鏈路本地、未指定位址等)
    // proxyAllowInternal: 'y' 整體關閉此拒絕 (僅限可信任網路); 'n' 預設
    // proxyAllowList: 只放寬所列者, 項為 IP ('127.0.0.1')、CIDR ('10.0.0.0/8') 或主機名 ('api.internal')
    proxyAllowInternal: 'n',
    proxyAllowList: [],

}
